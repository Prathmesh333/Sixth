# Default is an explicitly labeled, offline fixture mode. FalkorDB is required
# for the hackathon graph demonstration; no automatic fallback occurs.
SIXTH_MEMORY_BACKEND=sqlite_fixture
SIXTH_DATA_DIR=data
# Optional Neon/PostgreSQL connection string, including sslmode=require.
# SIXTH_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Required for any shared hosted demo; distribute privately, never commit its value.
# SIXTH_DEMO_ACCESS_CODE=
SIXTH_FALKORDB_HOST=127.0.0.1
SIXTH_FALKORDB_PORT=6379
# SIXTH_FALKORDB_USERNAME=
# SIXTH_FALKORDB_PASSWORD=
SIXTH_FALKORDB_SSL=false
# Optional OpenAI-compatible model endpoint; absent keys use a labeled local planner.
SIXTH_MODEL_BASE_URL=https://api.openai.com/v1
SIXTH_MODEL_NAME=
SIXTH_MODEL_API_KEY=
# Demo login is for private localhost use only. No production auth is implemented.
SIXTH_DEMO_LOGIN=true
SIXTH_COOKIE_SECURE=false
# WhatsApp test integration: disabled until Meta setup and eligibility are verified.
SIXTH_WHATSAPP_ENABLED=false
SIXTH_WHATSAPP_SEND_ENABLED=false
# SIXTH_PUBLIC_URL=https://sixth-one.vercel.app
# SIXTH_WHATSAPP_APP_SECRET=          # Meta app secret: webhook signature only
# SIXTH_WHATSAPP_VERIFY_TOKEN=        # Random server secret copied into Meta webhook setup
# SIXTH_WHATSAPP_IDENTITY_SECRET=     # Separate stable random secret; do not rotate without migration
# SIXTH_WHATSAPP_ENCRYPTION_KEY=      # Fernet.generate_key(), encrypts channel inbox/outbox
# SIXTH_WHATSAPP_PHONE_NUMBER_ID=     # Meta numeric Phone Number ID, not the phone number
# SIXTH_WHATSAPP_BUSINESS_NUMBER=    # International digits only
# SIXTH_WHATSAPP_ALLOWED_NUMBERS=["15555550101"]
# SIXTH_WHATSAPP_ACCESS_TOKEN=        # Server-side Meta token
# SIXTH_WHATSAPP_API_VERSION=         # Explicit version supported by your Meta app
