{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sixth.example/specs/contracts.json",
  "title": "Sixth proposed contracts",
  "$defs": {
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "request_id",
        "retryable"
      ],
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "artifact_ref": {
          "type": "string"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "excerpt": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "source_id",
        "captured_at"
      ],
      "additionalProperties": false
    },
    "Assertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "predicate": {
          "type": "string"
        },
        "value": {},
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "confirmed",
            "superseded",
            "disputed"
          ]
        },
        "scope_type": {
          "type": "string",
          "enum": [
            "person",
            "event",
            "task"
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "subject_id",
        "predicate",
        "value",
        "status",
        "scope_type",
        "scope_id",
        "valid_from",
        "recorded_at",
        "version",
        "sources"
      ],
      "additionalProperties": false
    },
    "ActionPreview": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tool": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "fingerprint": {
          "type": "string"
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "type": "string",
          "enum": [
            "fixture",
            "sandbox",
            "live"
          ]
        },
        "effect_class": {
          "type": "string",
          "enum": [
            "read",
            "internal_write",
            "external_write",
            "irreversible"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "required": [
        "action_id",
        "decision_id",
        "tool",
        "arguments",
        "fingerprint",
        "plan_revision",
        "expires_at",
        "mode",
        "effect_class",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "ToolResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "reconciling",
            "cancelled"
          ]
        },
        "data": {},
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "external_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "fixture",
            "sandbox",
            "live"
          ]
        },
        "simulation": {
          "type": "boolean"
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retryable": {
          "type": "boolean"
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "data",
        "evidence",
        "external_refs",
        "mode",
        "simulation",
        "verified_at",
        "retryable"
      ],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "awaiting_input",
            "reconciling",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "completed_action_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "outstanding_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "status",
        "plan_revision",
        "completed_action_ids",
        "outstanding_steps",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "task.started",
            "context.retrieved",
            "memory.updated",
            "plan.updated",
            "input.required",
            "tool.started",
            "tool.completed",
            "tool.failed",
            "task.completed",
            "task.cancelled",
            "task.failed"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "task_id",
        "sequence",
        "type",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    },
    "MessageRequest": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "timezone": {
          "type": "string",
          "default": "Asia/Calcutta"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 20
        }
      },
      "required": [
        "text",
        "timezone"
      ],
      "additionalProperties": false
    },
    "MessageAccepted": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "events_url": {
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "events_url"
      ],
      "additionalProperties": false
    },
    "DecisionRequest": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "reject",
            "answer"
          ]
        },
        "fingerprint": {
          "type": "string"
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "answer": {
          "type": "string",
          "maxLength": 8000
        }
      },
      "required": [
        "decision_id",
        "decision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "enum": [
                  "approve",
                  "reject"
                ]
              }
            }
          },
          "then": {
            "required": [
              "fingerprint",
              "plan_revision"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "answer"
              }
            }
          },
          "then": {
            "required": [
              "answer"
            ]
          }
        }
      ]
    },
    "CorrectionRequest": {
      "type": "object",
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "value": {},
        "scope_type": {
          "type": "string",
          "enum": [
            "person",
            "event",
            "task"
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "expected_version",
        "value",
        "scope_type",
        "scope_id",
        "valid_from",
        "reason"
      ],
      "additionalProperties": false
    },
    "DeletionJob": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "failed"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "status",
        "target_id",
        "requested_at"
      ],
      "additionalProperties": false
    },
    "UploadSource": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "content_base64": {
          "type": "string",
          "maxLength": 14000000
        }
      },
      "required": [
        "filename",
        "content_type",
        "content_base64"
      ],
      "additionalProperties": false
    },
    "SourceAccepted": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "ready",
            "failed"
          ]
        }
      },
      "required": [
        "source_id",
        "status"
      ],
      "additionalProperties": false
    },
    "Conversation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "created_at"
      ],
      "additionalProperties": false
    },
    "MemoryPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assertion"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "Acknowledgement": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "accepted",
        "task_id"
      ],
      "additionalProperties": false
    }
  }
}
