      "DecisionRequest": {
        "type": "object",
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "answer"
            ]
          },
          "fingerprint": {
            "type": "string"
          },
          "plan_revision": {
            "type": "integer",
            "minimum": 1
          },
          "answer": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "required": [
          "decision_id",
          "decision"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "enum": [
                    "approve",
                    "reject"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "fingerprint",
                "plan_revision"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "answer"
                }
              }
            },
            "then": {
              "required": [
                "answer"
              ]
            }
          }
        ]
      },
